<%- include('partials/head') %>

<div class="layout">
  <%- include('partials/sidebar') %>

  <main class="main">
    <div class="topbar">
      <div>
        <h2 class="page-title"><span class="lang-id">Valorant Config</span><span class="lang-en">Valorant Config</span></h2>
        <p class="page-sub"><code style="font-size:.9em;color:var(--cyan)">/api/game/valorant</code> — Konfigurasi endpoint Valorant</p>
      </div>
    </div>

    <% if (success_msg.length > 0) { %><div class="alert alert-success"><%= success_msg[0] %></div><% } %>
    <% if (error_msg.length > 0)   { %><div class="alert alert-error"><%= error_msg[0] %></div><% } %>

    <div class="stats-grid" style="margin-bottom:1.5rem;">
      <div class="stat-card">
        <div class="stat-icon stat-icon--cyan">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 22 8.5 22 15.5 12 22 2 15.5 2 8.5 12 2"/><line x1="12" y1="22" x2="12" y2="15.5"/><polyline points="22 8.5 12 15.5 2 8.5"/></svg>
        </div>
        <div>
          <div class="stat-num"><%= cfg.valorant_max_device || 500 %></div>
          <div class="stat-label">Max Device</div>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon stat-icon--green">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
        </div>
        <div>
          <div class="stat-num"><%= devices.length %></div>
          <div class="stat-label">Registered Devices</div>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon stat-icon--warn">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M2 12h20"/></svg>
        </div>
        <div>
          <div class="stat-num"><%= cfg.valorant_date || '20251231' %></div>
          <div class="stat-label">Date</div>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon stat-icon--purple">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <div>
          <div class="stat-num"><%= cfg.valorant_time || '23:59' %></div>
          <div class="stat-label">Time</div>
        </div>
      </div>
    </div>

    <div class="card card-info" style="margin-bottom:1.25rem;">
      <div class="card-header">
        <h3 class="card-title"><span class="lang-id">Konfigurasi Endpoint</span><span class="lang-en">Endpoint Configuration</span></h3>
      </div>
      <div class="card-body">
        <form action="/admin/valorant" method="POST" style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
          <div class="field">
            <label class="field-label">Date (YYYYMMDD)</label>
            <input type="text" name="valorant_date" class="field-input"
              value="<%= cfg.valorant_date || '20251231' %>" required>
            <div class="field-hint">Format: YYYYMMDD (contoh: 20251231)</div>
          </div>

          <div class="field">
            <label class="field-label">Time (HH:MM)</label>
            <input type="text" name="valorant_time" class="field-input"
              value="<%= cfg.valorant_time || '23:59' %>" required>
            <div class="field-hint">Format: HH:MM (contoh: 23:59)</div>
          </div>

          <div class="field">
            <label class="field-label">Max Device</label>
            <input type="number" name="valorant_max_device" class="field-input"
              value="<%= cfg.valorant_max_device || '500' %>" min="1" required>
          </div>

          <div class="field">
            <label class="field-label">Is Shareable</label>
            <select name="valorant_is_shareable" class="field-input">
              <option value="true" <%= (cfg.valorant_is_shareable || 'true') === 'true' ? 'selected' : '' %>>true</option>
              <option value="false" <%= (cfg.valorant_is_shareable || '') === 'false' ? 'selected' : '' %>>false</option>
            </select>
          </div>

          <div class="field" style="grid-column:1/-1;">
            <label class="field-label">User Key</label>
            <input type="text" name="valorant_user_key" class="field-input"
              value="<%= cfg.valorant_user_key || 'KONTOL' %>" required>
            <div class="field-hint">Nilai field <code>userKey</code> di response GET</div>
          </div>

          <div style="grid-column:1/-1;display:flex;gap:.75rem;margin-top:.5rem;">
            <button type="submit" class="btn btn-primary">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
              Simpan Konfigurasi
            </button>
            <a href="/admin/dashboard" class="btn btn-ghost">Kembali</a>
          </div>
        </form>
      </div>
    </div>

    <div class="card">
      <div class="card-header">
        <h3 class="card-title">
          <span class="lang-id">Registered Devices</span><span class="lang-en">Registered Devices</span>
          <span class="badge badge-count" style="margin-left:.5rem;"><%= devices.length %></span>
        </h3>
      </div>
      <div class="card-body" style="padding:0;">
        <% if (devices.length === 0) { %>
          <div style="padding:2rem;text-align:center;color:var(--text-3);font-size:.85rem;">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="opacity:.3;margin-bottom:.5rem;"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
            <div>Belum ada device terdaftar.</div>
            <div style="font-size:.75rem;margin-top:.25rem;">Device akan muncul saat client melakukan POST /api/game/valorant</div>
          </div>
        <% } else { %>
          <div class="table-wrap">
            <table class="table">
              <thead>
                <tr>
                  <th>Name</th>
                  <th>Device ID</th>
                  <th>Registered At</th>
                  <th style="width:80px;">Action</th>
                </tr>
              </thead>
              <tbody>
                <% devices.forEach(d => { %>
                  <tr>
                    <td><code class="key-code"><%= d.name %></code></td>
                    <td><code><%= d.device_id %></code></td>
                    <td><%= new Date(Number(d.created_at) * 1000).toLocaleString('id-ID', {timeZone:'Asia/Jakarta'}) %></td>
                    <td>
                      <form action="/admin/valorant/<%= d.id %>/delete-device" method="POST" style="display:inline;">
                        <button type="submit" class="btn-icon btn-del" title="Hapus device" onclick="return confirm('Hapus device <%= d.name %>?')">
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                        </button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>

    <div class="card">
      <div class="card-header">
        <h3 class="card-title">Endpoint Info</h3>
      </div>
      <div class="card-body" style="padding:1rem 1.25rem;">
        <div style="display:grid;grid-template-columns:auto 1fr;gap:.5rem 1rem;font-size:.85rem;">
          <span class="method-badge" style="background:rgba(0,229,255,.1);color:var(--cyan);border-color:rgba(0,229,255,.2);">GET</span>
          <span><code>/api/game/valorant</code> — Ambil status + daftar device terdaftar</span>

          <span class="method-badge" style="background:rgba(0,255,136,.1);color:var(--green);border-color:rgba(0,255,136,.2);">POST</span>
          <span><code>/api/game/valorant</code> — Daftarkan deviceId (body: raw string deviceId)</span>

          <span class="method-badge" style="background:rgba(168,85,247,.1);color:var(--purple);border-color:rgba(168,85,247,.2);">PATCH</span>
          <span><code>/api/game/valorant</code> — Update used (selalu response <code>{"used":0}</code>)</span>
        </div>
      </div>
    </div>
  </main>
</div>

<script src="/js/main.js"></script>
</body>
</html>