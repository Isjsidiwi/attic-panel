<div class="content-card">
  <div class="card-header">
    <h2 class="page-title">Valorant Config — <code style="font-size:.9em;color:var(--cyan)">/api/game/valorant</code></h2>
    <p class="page-sub">Konfigurasi respons endpoint Valorant secara dinamis</p>
  </div>

  <% if (success_msg.length) { %>
    <div class="alert alert-success"><%= success_msg[0] %></div>
  <% } %>
  <% if (error_msg.length) { %>
    <div class="alert alert-error"><%= error_msg[0] %></div>
  <% } %>

  <form action="/admin/valorant" method="POST">
    <div class="field-group">
      <label class="field-label">Date <span class="req">*</span></label>
      <input type="text" name="valorant_date" class="field-input"
        value="<%= cfg.valorant_date || '20251231' %>" required>
      <span class="field-hint">Format: YYYYMMDD (contoh: 20251231)</span>
    </div>

    <div class="field-group">
      <label class="field-label">Time <span class="req">*</span></label>
      <input type="text" name="valorant_time" class="field-input"
        value="<%= cfg.valorant_time || '23:59' %>" required>
      <span class="field-hint">Format: HH:MM (contoh: 23:59)</span>
    </div>

    <div class="field-group">
      <label class="field-label">Max Device <span class="req">*</span></label>
      <input type="number" name="valorant_max_device" class="field-input"
        value="<%= cfg.valorant_max_device || '500' %>" required min="1">
    </div>

    <div class="field-group">
      <label class="field-label">Is Shareable</label>
      <select name="valorant_is_shareable" class="field-input">
        <option value="true" <%= (cfg.valorant_is_shareable || 'true') === 'true' ? 'selected' : '' %>>true</option>
        <option value="false" <%= (cfg.valorant_is_shareable || '') === 'false' ? 'selected' : '' %>>false</option>
      </select>
    </div>

    <div class="field-group">
      <label class="field-label">User Key <span class="req">*</span></label>
      <input type="text" name="valorant_user_key" class="field-input"
        value="<%= cfg.valorant_user_key || 'KONTOL' %>" required>
    </div>

    <div style="margin-top: 1.5rem; display:flex; gap:.75rem;">
      <button type="submit" class="btn btn-primary">Simpan Konfigurasi</button>
      <a href="/admin/dashboard" class="btn btn-ghost">Kembali</a>
    </div>
  </form>

  <div style="margin-top:2rem;">
    <div class="card-header">
      <h3>Registered Devices (<%= devices.length %>)</h3>
    </div>
    <% if (devices.length === 0) { %>
      <p style="color:var(--muted);padding:1rem;">Belum ada device terdaftar.</p>
    <% } else { %>
      <table class="table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Device ID</th>
            <th>Registered At</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% devices.forEach(d => { %>
            <tr>
              <td><code><%= d.name %></code></td>
              <td><code><%= d.device_id %></code></td>
              <td><%= new Date(Number(d.created_at) * 1000).toLocaleString('id-ID') %></td>
              <td>
                <form action="/admin/valorant/<%= d.id %>/delete-device" method="POST" style="display:inline;">
                  <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Hapus device ini?')">Delete</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>

  <div style="margin-top:2rem; padding:1rem; background:var(--card); border:1px solid var(--border); border-radius:8px;">
    <h4 style="margin-bottom:.5rem; color:var(--cyan);">Endpoint Info</h4>
    <table class="table" style="font-size:.85rem;">
      <tr><td><strong>GET</strong></td><td><code>/api/game/valorant</code></td><td>Ambil status + device terdaftar</td></tr>
      <tr><td><strong>POST</strong></td><td><code>/api/game/valorant</code></td><td>Daftarkan deviceId (body raw: "deviceId" string)</td></tr>
      <tr><td><strong>PATCH</strong></td><td><code>/api/game/valorant</code></td><td>Update used (selalu balikin <code>{"used":0}</code>)</td></tr>
    </table>
  </div>
</div>