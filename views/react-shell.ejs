<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — <%= panel_name %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;700;900&family=Poppins:wght@300;400;500;600;700&family=IBM+Plex+Mono:ital,wght@0,300;0,400;0,500;1,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/imgui.css">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: { primary: '#00e5ff', secondary: '#a855f7', dark: '#070b10', darker: '#0c1118' },
          fontFamily: { sans: ['Poppins', 'sans-serif'], mono: ['IBM Plex Mono', 'monospace'] }
        }
      }
    };
  </script>
  <style>
    body.login-view {
      background-image: radial-gradient(circle at top right, rgba(168, 85, 247, 0.15), transparent 40%), radial-gradient(circle at bottom left, rgba(0, 229, 255, 0.15), transparent 40%), url('/img/mobile-bg.png');
      background-color: #070b10;
      background-size: cover;
      background-position: center;
      background-attachment: fixed;
      color: #e2e8f0;
      font-family: 'Poppins', sans-serif;
    }
    .glass-card { background: rgba(12, 17, 24, 0.7); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border: 1px solid rgba(255, 255, 255, 0.08); box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5); }
    .input-glow:focus { box-shadow: 0 0 15px rgba(0, 229, 255, 0.2); border-color: #00e5ff; }
    :root.light-theme body.login-view { background: #f4f7f6; color: #1a202c; }
    :root.light-theme .glass-card { background: rgba(255, 255, 255, 0.9); border: 1px solid rgba(0, 0, 0, 0.1); box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.1); }
    :root.light-theme .dark-text-white { color: #1a202c !important; }
    :root.light-theme .dark-text-gray { color: #4a5568 !important; }
    :root.light-theme .dark-input { background-color: #ffffff !important; border-color: #cbd5e1 !important; color: #1a202c !important; }

    body.store-view { background: #09090b; color: #f8fafc; font-family: 'Inter', sans-serif; min-height: 100vh; -webkit-font-smoothing: antialiased; background-image: url('https://www.cloudsky.biz.id/api/file/Wallpaper%20Anime%20Frieren%20Gunung%20Musim%20Dingin%20-%204K.png'); background-size: cover; background-position: center; background-attachment: fixed; background-repeat: no-repeat; }
    @media (max-width: 768px) { body.store-view { background-image: url('https://www.cloudsky.biz.id/api/file/9NF1w.jpg'); } }
    body.store-view { --bg:#09090b; --surface:#18181b; --surface2:#27272a; --border:#3f3f46; --accent:#3b82f6; --accent-hover:#2563eb; --text:#f8fafc; --muted:#a1a1aa; }
    html.light-theme body.store-view { --bg:#f5f7fb; --surface:#fff; --surface2:#eef2f7; --border:#d9e2ee; --accent:#2563eb; --accent-hover:#1d4ed8; --text:#101828; --muted:#667085; }
    .bg-overlay { position: fixed; inset: 0; background: rgba(9, 9, 11, 0.7); backdrop-filter: blur(5px); -webkit-backdrop-filter: blur(5px); z-index: 0; pointer-events: none; }
    html.light-theme .bg-overlay { background: rgba(245, 247, 251, 0.72); }
    .mono { font-family: 'JetBrains Mono', monospace; }
    body.store-view .card { background: rgba(24, 24, 27, 0.85); backdrop-filter: blur(10px); border: 1px solid var(--border); border-radius: 8px; transition: all 0.3s ease; box-shadow: 0 4px 6px -1px rgba(0,0,0,.3), 0 2px 4px -1px rgba(0,0,0,.2); }
    html.light-theme body.store-view .card { background: rgba(255,255,255,.86); box-shadow: 0 12px 32px rgba(15,23,42,.08); }
    .btn { display: inline-flex; align-items: center; justify-content: center; border-radius: 8px; padding: .75rem 1.5rem; font-weight: 600; font-size: .95rem; transition: all .2s ease; cursor: pointer; }
    .btn-outline { background: transparent; color: var(--text); border: 1px solid var(--border); }
    .btn-outline:hover { background: var(--surface2); border-color: #52525b; }
    body.store-view .field { background: rgba(9,9,11,.8); border:1px solid var(--border); color:var(--text); border-radius:8px; padding:.75rem 1rem; font-family:'Inter',sans-serif; transition:all .2s ease; outline:none; width:100%; box-shadow:inset 0 1px 2px rgba(0,0,0,.1); }
    html.light-theme body.store-view .field { background: rgba(255,255,255,.92); }
    body.store-view .field:focus { border-color: var(--accent); box-shadow: 0 0 0 2px rgba(59,130,246,.2); }
    .mesh { position: fixed; inset: 0; background: radial-gradient(circle at top, rgba(59,130,246,.15) 0%, transparent 50%); pointer-events:none; z-index:0; }
    .wrap { position: relative; z-index: 1; }
    body.store-view nav { backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); background: rgba(9,9,11,.6) !important; border-bottom: 1px solid rgba(63,63,70,.5); }
    html.light-theme body.store-view nav { background: rgba(255,255,255,.76) !important; }
    .store-tool { width:36px; height:36px; border-radius:8px; border:1px solid var(--border); color:var(--text); display:inline-flex; align-items:center; justify-content:center; background:rgba(255,255,255,.04); }
    .store-tool:hover { border-color:var(--accent); color:var(--accent); }
    .payment-chip { display:inline-flex; align-items:center; gap:.45rem; padding:.45rem .7rem; border-radius:8px; border:1px solid var(--border); background:rgba(255,255,255,.04); font-size:.75rem; font-weight:800; color:var(--text); }
    .payment-logo { width:22px; height:22px; border-radius:6px; display:inline-flex; align-items:center; justify-content:center; color:#fff; font-size:.58rem; font-weight:900; }
    .payment-logo.qris { background:#111827; } .payment-logo.gopay { background:#00AED6; } .payment-logo.dana { background:#118EEA; } .payment-logo.ovo { background:#4C3494; } .payment-logo.bca { background:#0066AE; } .payment-logo.bri { background:#00529C; } .payment-logo.seabank { background:#ff6b00; } .payment-logo.jago { background:#f7a600; color:#101828; }
    .cg-card { background:#161B22; border:1px solid #30363D; border-radius:12px; }
    .cg-card-hover:hover { border-color:#3b82f6; box-shadow:0 0 15px rgba(59,130,246,.15); }
    .cg-text-primary { color:#60a5fa; }
    .cg-bg-primary { background:#3b82f6; color:#fff; }
    .cg-btn-primary { background:#3b82f6; color:#fff; font-weight:bold; border-radius:8px; transition:all .2s; }
    .cg-btn-primary:hover { background:#2563eb; }
    .cg-btn-outline { border:1px solid #3b82f6; color:#60a5fa; background:transparent; transition:all .2s; }
    .cg-btn-outline:hover { background:rgba(59,130,246,.1); }
    .no-scrollbar::-webkit-scrollbar { display:none; } .no-scrollbar { -ms-overflow-style:none; scrollbar-width:none; }
    .cs-float { position:fixed; bottom:24px; right:24px; z-index:100; transform:translateY(0); transition:all .3s cubic-bezier(.34,1.56,.64,1); }
    .cs-float:hover { transform:translateY(-5px); }
    .asset-loader { position:fixed; inset:0; background:var(--bg); z-index:99999; display:flex; align-items:center; justify-content:center; flex-direction:column; transition:opacity .25s ease, visibility .25s ease; }
    .asset-loader.is-hidden { opacity:0; visibility:hidden; pointer-events:none; }
    .loader-card { background:var(--surface); border:1px solid var(--border); padding:2.5rem; border-radius:20px; box-shadow:0 25px 50px -12px rgba(0,0,0,.5); width:90%; max-width:400px; text-align:center; }
    .loader-spinner { width:50px; height:50px; border:4px solid rgba(59,130,246,.1); border-radius:50%; border-top-color:var(--accent); animation:spin 1s linear infinite; margin:0 auto 1.5rem; }
    .loader-title { font-size:1.25rem; font-weight:700; margin-bottom:1.5rem; color:var(--text); }
    .loader-bar { width:100%; height:8px; background:var(--surface2); border-radius:999px; overflow:hidden; }
    .loader-bar-fill { height:100%; background:linear-gradient(90deg,#3b82f6,#8b5cf6); border-radius:999px; transition:width .1s linear; }
    .loader-sub { margin-top:1rem; font-size:.85rem; color:var(--muted); font-family:'JetBrains Mono',monospace; }
    @keyframes spin { to { transform: rotate(360deg); } }
  </style>
  <script>
    if (localStorage.getItem('theme') === 'light') document.documentElement.classList.add('light-theme');
    document.documentElement.setAttribute('data-lang', localStorage.getItem('lang') || 'id');
    window.__APP_DATA__ = <%- appData %>;
  </script>
</head>
<body class="<%= bodyClass || '' %>">
  <div id="root"></div>
  <script type="module" src="/react/assets/app.js"></script>
</body>
</html>
