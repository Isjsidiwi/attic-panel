<%- include('partials/head') %>

<div class="layout">
  <%- include('partials/sidebar') %>

  <main class="main">
    <div class="topbar">
      <div>
        <h2 class="page-title">⚙️ Necro MLBB — <code style="font-size:.9em;color:var(--cyan)">/api/game/qy</code></h2>
        <p class="page-sub">Konfigurasi respons endpoint MLBB (Necro) secara dinamis</p>
      </div>
    </div>

    <% if (success_msg.length > 0) { %><div class="alert alert-success"><%= success_msg[0] %></div><% } %>
    <% if (error_msg.length > 0)   { %><div class="alert alert-error"><%= error_msg[0] %></div><% } %>

    <form action="/admin/necro" method="POST">
      <div class="settings-grid" style="grid-template-columns: 1fr 1fr; gap: 1.2rem;">

        <!-- === CARD 1: Identitas Mod === -->
        <div class="card">
          <div class="card-header">
            <h3 class="card-title">🎮 Identitas Mod</h3>
          </div>
          <div class="card-body">
            <div class="field">
              <label class="field-label">REGISTRATOR</label>
              <input type="text" name="necro_registrator" class="field-input"
                value="<%= cfg.necro_registrator || 'Izumi' %>" required>
              <p class="field-hint">Nilai field <code>registrator</code> & <code>registeredAs</code></p>
            </div>
            <div class="field">
              <label class="field-label">CUSTOM TITLE</label>
              <input type="text" name="necro_custom_title" class="field-input"
                value="<%= cfg.necro_custom_title || 'ATHARYX NIH BOS' %>">
              <p class="field-hint">Nilai field <code>custom_title</code></p>
            </div>
            <div class="field">
              <label class="field-label">TITTLE / TITLE / MOD NAME</label>
              <input type="text" name="necro_tittle" class="field-input"
                value="<%= cfg.necro_tittle || 'KillCracked ' %>">
              <p class="field-hint">Nilai field <code>tittle</code>, <code>title</code>, <code>modname</code>, <code>MOD_NAME</code></p>
            </div>
            <div class="field">
              <label class="field-label">SUBTITLE / CREDIT / FLOTING_TEST</label>
              <input type="text" name="necro_subtitle" class="field-input"
                value="<%= cfg.necro_subtitle || 'Give Feedback else Keys off' %>">
            </div>
            <div class="field">
              <label class="field-label">MOD STATUS</label>
              <input type="text" name="necro_mod_status" class="field-input"
                value="<%= cfg.necro_mod_status || 'Safe' %>">
              <p class="field-hint">Nilai field <code>mod_status</code>, <code>MOD_STATUS</code></p>
            </div>
            <div class="field">
              <label class="field-label">TYPE KEY</label>
              <select name="necro_type" class="field-input">
                <option value="premium" <%= (cfg.necro_type || 'premium') === 'premium' ? 'selected' : '' %>>premium</option>
                <option value="vip"     <%= (cfg.necro_type || '') === 'vip'     ? 'selected' : '' %>>vip</option>
                <option value="free"    <%= (cfg.necro_type || '') === 'free'    ? 'selected' : '' %>>free</option>
              </select>
            </div>
          </div>
        </div>

        <!-- === CARD 2: Token & Keamanan === -->
        <div class="card">
          <div class="card-header">
            <h3 class="card-title">🔐 Token & Keamanan</h3>
          </div>
          <div class="card-body">
            <div class="field">
              <label class="field-label">BTDATA (Label)</label>
              <input type="text" name="necro_btdata" class="field-input"
                value="<%= cfg.necro_btdata || 'BattleData' %>">
            </div>
            <div class="field">
              <label class="field-label">BTDATA SAFE VALUE</label>
              <input type="text" name="necro_btdata_safe" class="field-input"
                value="<%= cfg.necro_btdata_safe || 'Safe' %>">
            </div>
            <div class="field">
              <label class="field-label">VVIPMODSGR (Base64)</label>
              <input type="text" name="necro_vvipmodsgr" class="field-input"
                value="<%= cfg.necro_vvipmodsgr || 'QUh/k8wd+CfJxob7qKlIyMlHfxiauTXyjkN6258nbu0=' %>">
            </div>
            <div class="field">
              <label class="field-label">VVIPMODS</label>
              <input type="text" name="necro_VVIPMODS" class="field-input"
                value="<%= cfg.necro_VVIPMODS || 'OK' %>">
            </div>
            <div class="field">
              <label class="field-label">CANTCRACK KIRITO</label>
              <textarea name="necro_cantcrackkirito" class="field-input" rows="2"><%= cfg.necro_cantcrackkirito || 'namohindimoakomacacrackbrokettawaginmobuongdiyosdiyosanniyo' %></textarea>
            </div>
            <div class="field">
              <label class="field-label">CANTCRACK (Base64)</label>
              <input type="text" name="necro_cantcrack" class="field-input"
                value="<%= cfg.necro_cantcrack || '5DXuN61YKEgIhKNqa6PbJgf8DXm1Sft10sEEfFs9st8=' %>">
            </div>
            <div class="field">
              <label class="field-label">OWNMOD (Base64)</label>
              <input type="text" name="necro_ownmod" class="field-input"
                value="<%= cfg.necro_ownmod || 'Rtc2ximHdWn+2LoOACPNH/BZ6IHhch+/pLkvdoo9gRw=' %>">
            </div>
            <div class="field">
              <label class="field-label">XENOANTICRACK (Base64)</label>
              <textarea name="necro_xenoanticrack" class="field-input" rows="2"><%= cfg.necro_xenoanticrack || 'YDPsDmdATek4YTC2yX0zF914WTB/hLd1hWo+EkFAiUAkn9GAOcR7xcWMQ3n8jifrWZvZxsAZwf8hKd7pChs3cQ==' %></textarea>
            </div>
          </div>
        </div>

        <!-- === CARD 3: Pengaturan Lanjutan === -->
        <div class="card">
          <div class="card-header">
            <h3 class="card-title">⚙️ Pengaturan Lanjutan</h3>
          </div>
          <div class="card-body">
            <div class="field">
              <label class="field-label">ANTIBAN DNS</label>
              <select name="necro_antiban_dns" class="field-input">
                <option value="false" <%= (cfg.necro_antiban_dns || 'false') === 'false' ? 'selected' : '' %>>false</option>
                <option value="true"  <%= (cfg.necro_antiban_dns || '') === 'true'  ? 'selected' : '' %>>true</option>
              </select>
            </div>
            <div class="field">
              <label class="field-label">FEATURE MODE</label>
              <input type="text" name="necro_feature_mode" class="field-input"
                value="<%= cfg.necro_feature_mode || '1' %>">
              <p class="field-hint">Nilai field <code>feature_mode</code></p>
            </div>
            <div class="field">
              <label class="field-label">LOGIN TYPE</label>
              <select name="necro_login_type" class="field-input">
                <option value="stay" <%= (cfg.necro_login_type || 'stay') === 'stay' ? 'selected' : '' %>>stay</option>
                <option value="once" <%= (cfg.necro_login_type || '') === 'once' ? 'selected' : '' %>>once</option>
              </select>
            </div>
          </div>
        </div>

        <!-- === CARD 4: Feature Flags === -->
        <div class="card">
          <div class="card-header">
            <h3 class="card-title">🧩 Feature Flags</h3>
            <span class="text-muted" style="font-size:.72rem">Centang = true di respons API</span>
          </div>
          <div class="card-body">
            <div class="game-permission-grid" style="grid-template-columns: 1fr 1fr;">
              <% const features = [
                { key: 'necro_feat_bypass',          label: 'Bypass' },
                { key: 'necro_feat_drone_view',       label: 'Drone View' },
                { key: 'necro_feat_no_grass',         label: 'No Grass' },
                { key: 'necro_feat_maphack',          label: 'MapHack' },
                { key: 'necro_feat_esp',              label: 'ESP Player' },
                { key: 'necro_feat_retri_hack',       label: 'Retri Hack' },
                { key: 'necro_feat_unlock_skin',      label: 'Unlock Skin' },
                { key: 'necro_feat_skill_hack',       label: 'Skill Hack' },
                { key: 'necro_feat_skill_cd',         label: 'Skill CD' },
                { key: 'necro_feat_floating_button',  label: 'Floating Button' }
              ]; %>
              <% features.forEach(f => { %>
                <label class="permission-chip">
                  <input type="checkbox" name="<%= f.key %>" value="true"
                    <%= (cfg[f.key] === 'true' || cfg[f.key] === true) ? 'checked' : '' %>>
                  <span><%= f.label %></span>
                </label>
              <% }) %>
            </div>
          </div>
        </div>

      </div><!-- end settings-grid -->

      <!-- Endpoint info banner -->
      <div class="card" style="margin-top:1rem;border-color:var(--cyan);background:rgba(0,229,255,.04)">
        <div class="card-body" style="display:flex;align-items:center;gap:1rem;flex-wrap:wrap">
          <div>
            <div style="font-size:.7rem;text-transform:uppercase;letter-spacing:.08em;color:var(--text-muted);margin-bottom:.25rem">Endpoint URL</div>
            <code style="color:var(--cyan);font-size:.85rem">POST /api/game/qy</code>
          </div>
          <div style="flex:1"></div>
          <div style="font-size:.75rem;color:var(--text-muted)">
            Field dinamis dari DB: <strong style="color:var(--text)">registrator, tittle, subtitle, feature flags, dll.</strong><br>
            Field dari key: <strong style="color:var(--text)">expiredAt, maxDevices, remainingSlot, serial, token (auto MD5)</strong>
          </div>
        </div>
      </div>

      <div style="margin-top:1.5rem;display:flex;justify-content:flex-end">
        <button type="submit" class="btn-primary">💾 Simpan Konfigurasi</button>
      </div>
    </form>
  </main>
</div>

<script src="/js/main.js"></script>
</body>
</html>
