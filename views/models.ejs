<%- include('partials/head') %>
<style>
    /* Styling for the 3D Model Viewer inspired by model.vercel.app */
    .model-viewer-container {
        position: relative;
        width: 100%;
        height: 600px;
        background-color: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        overflow: hidden;
        margin-bottom: 1.5rem;
    }
    
    #canvas-container {
        width: 100%;
        height: 100%;
        cursor: grab;
    }
    
    #canvas-container:active {
        cursor: grabbing;
    }
    
    .model-controls {
        position: absolute;
        bottom: 1rem;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        gap: 0.5rem;
        background: rgba(0, 0, 0, 0.5);
        padding: 0.5rem;
        border-radius: 2rem;
        backdrop-filter: blur(4px);
    }
    
    .model-btn {
        background: var(--surface-light);
        border: 1px solid var(--border);
        color: var(--text);
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s;
    }
    
    .model-btn:hover {
        background: var(--primary);
        color: var(--bg);
        border-color: var(--primary);
    }
    
    .model-btn.active {
        background: var(--cyan);
        color: var(--bg);
        border-color: var(--cyan);
    }
    
    .model-selector {
        position: absolute;
        top: 1rem;
        right: 1rem;
        background: rgba(0, 0, 0, 0.7);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 0.5rem;
        backdrop-filter: blur(4px);
        max-width: 250px;
        max-height: 300px;
        overflow-y: auto;
    }
    
    .model-item {
        padding: 0.5rem;
        cursor: pointer;
        border-radius: 0.25rem;
        transition: background 0.2s;
        font-size: 0.875rem;
        color: var(--text-muted);
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    
    .model-item:hover {
        background: var(--surface-light);
        color: var(--text);
    }
    
    .model-item.selected {
        background: var(--primary-alpha);
        color: var(--primary);
        border-left: 2px solid var(--primary);
    }
    
    .model-item-icon {
        width: 16px;
        height: 16px;
        flex-shrink: 0;
    }
    
    .loading-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.7);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        z-index: 10;
        transition: opacity 0.3s;
    }
    
    .loading-spinner {
        width: 40px;
        height: 40px;
        border: 3px solid rgba(255,255,255,0.1);
        border-radius: 50%;
        border-top-color: var(--primary);
        animation: spin 1s ease-in-out infinite;
        margin-bottom: 1rem;
    }
    
    .loading-text {
        font-family: monospace;
        color: var(--primary);
        letter-spacing: 2px;
    }
    
    .loading-progress {
        width: 200px;
        height: 4px;
        background: rgba(255,255,255,0.1);
        border-radius: 2px;
        margin-top: 1rem;
        overflow: hidden;
    }
    
    .loading-bar {
        height: 100%;
        background: var(--primary);
        width: 0%;
        transition: width 0.1s;
    }
    
    @keyframes pulse {
        0% { opacity: 1; }
        50% { opacity: 0.5; }
        100% { opacity: 1; }
    }
    
    @keyframes spin {
        to { transform: rotate(360deg); }
    }
    
    .upload-section {
        background: var(--surface);
        border: 1px dashed var(--border);
        border-radius: var(--radius);
        padding: 2rem;
        text-align: center;
        margin-bottom: 1.5rem;
        transition: border-color 0.3s;
    }
    
    .upload-section:hover {
        border-color: var(--primary);
    }
    
    .upload-icon {
        width: 48px;
        height: 48px;
        color: var(--text-muted);
        margin-bottom: 1rem;
    }
    
    .models-list-table {
        width: 100%;
        border-collapse: collapse;
    }
    
    .models-list-table th, .models-list-table td {
        padding: 1rem;
        text-align: left;
        border-bottom: 1px solid var(--border);
    }
    
    .models-list-table th {
        color: var(--text-muted);
        font-weight: 500;
        font-size: 0.875rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }
    
    .models-list-table tr:hover {
        background: var(--surface-light);
    }
    
    .empty-state {
        text-align: center;
        padding: 3rem;
        color: var(--text-muted);
    }
</style>

<%- include('partials/sidebar') %>

<main class="main-content">
  <div class="content-header">
    <h1 class="page-title">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:0.5rem;color:var(--primary);"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
      Model 3D Viewer
    </h1>
    <p style="color:var(--text-muted);margin-top:0.25rem;">Preview dan kelola model 3D interaktif</p>
  </div>
  
  <% if (success_msg.length > 0) { %>
      <div class="alert alert-success" style="margin-bottom: 1rem;"><%= success_msg[0] %></div>
  <% } %>
  <% if (error_msg.length > 0) { %>
      <div class="alert alert-error" style="margin-bottom: 1rem;"><%= error_msg[0] %></div>
  <% } %>

  <div class="model-viewer-container">
      <div id="loading-overlay" class="loading-overlay" style="display: none;">
          <div class="loading-spinner"></div>
          <div class="loading-text">LOADING MODEL...</div>
          <div class="loading-progress">
              <div id="loading-bar" class="loading-bar"></div>
          </div>
          <div id="loading-percentage" style="margin-top: 0.5rem; font-family: monospace; font-size: 0.875rem;">0%</div>
      </div>
      
      <div id="canvas-container"></div>
      
      <div class="model-selector">
          <div style="padding: 0.5rem; font-weight: 600; border-bottom: 1px solid var(--border); margin-bottom: 0.5rem; font-size: 0.875rem;">Model Tersedia</div>
          <% if (models.length === 0) { %>
              <div style="padding: 0.5rem; font-size: 0.875rem; color: var(--text-muted); text-align: center;">Belum ada model</div>
          <% } else { %>
              <% models.forEach((model, index) => { %>
                  <div class="model-item <%= index === 0 ? 'selected' : '' %>" data-path="<%= model.path %>" onclick="loadModel('<%= model.path %>', this)">
                      <svg class="model-item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path></svg>
                      <%= model.name %>
                  </div>
              <% }) %>
          <% } %>
      </div>
      
      <div class="model-controls">
          <button class="model-btn active" id="btn-rotate" title="Auto Rotate" onclick="toggleAutoRotate()">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
          </button>
          <button class="model-btn" id="btn-wireframe" title="Wireframe Mode" onclick="toggleWireframe()">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
          </button>
          <button class="model-btn" id="btn-reset" title="Reset View" onclick="resetCamera()">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h6v6"/><path d="M9 21H3v-6"/><path d="M21 3l-7 7"/><path d="M3 21l7-7"/></svg>
          </button>
      </div>
  </div>

  <div class="card">
      <div class="card-header">
          <h2 class="card-title">Upload Model Baru</h2>
      </div>
      <div class="card-body">
          <form action="/admin/models/upload" method="POST" enctype="multipart/form-data" class="upload-section">
              <svg class="upload-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
              <h3 style="margin-bottom: 0.5rem;">Drag & Drop atau Pilih File</h3>
              <p style="color: var(--text-muted); font-size: 0.875rem; margin-bottom: 1.5rem;">Mendukung format .gltf, .glb, .obj, .fbx (Maks 50MB)</p>
              
              <input type="file" id="modelFile" name="modelFile" accept=".gltf,.glb,.obj,.fbx,.stl" style="display: none;" onchange="updateFileName(this)">
              <div style="display: flex; gap: 1rem; justify-content: center; align-items: center;">
                  <button type="button" class="btn btn-outline" onclick="document.getElementById('modelFile').click()">Pilih File</button>
                  <span id="fileNameDisplay" style="font-family: monospace; color: var(--cyan);"></span>
                  <button type="submit" class="btn btn-primary" id="uploadBtn" style="display: none;">Upload Sekarang</button>
              </div>
          </form>

          <h3 style="margin: 2rem 0 1rem;">Daftar Model Tersimpan</h3>
          <div class="table-responsive">
              <table class="models-list-table">
                  <thead>
                      <tr>
                          <th>Nama File</th>
                          <th>Ukuran</th>
                          <th>Tanggal Upload</th>
                          <th>Aksi</th>
                      </tr>
                  </thead>
                  <tbody>
                      <% if (models.length === 0) { %>
                          <tr>
                              <td colspan="4">
                                  <div class="empty-state">
                                      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" style="opacity: 0.5; margin-bottom: 1rem;"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path></svg>
                                      <p>Belum ada model 3D yang diupload.</p>
                                  </div>
                              </td>
                          </tr>
                      <% } else { %>
                          <% models.forEach(model => { %>
                              <tr>
                                  <td style="font-weight: 500;"><%= model.name %></td>
                                  <td style="font-family: monospace;"><%= model.size %></td>
                                  <td><%= new Date(model.date).toLocaleString('id-ID') %></td>
                                  <td>
                                      <div style="display: flex; gap: 0.5rem;">
                                          <button type="button" class="btn btn-outline btn-sm" onclick="loadModel('<%= model.path %>', null, '<%= model.name %>')">Lihat</button>
                                          <form action="/admin/models/delete" method="POST" style="display: inline;" onsubmit="return confirm('Yakin ingin menghapus model ini?');">
                                              <input type="hidden" name="filename" value="<%= model.name %>">
                                              <button type="submit" class="btn btn-danger btn-sm">Hapus</button>
                                          </form>
                                      </div>
                                  </td>
                              </tr>
                          <% }) %>
                      <% } %>
                  </tbody>
              </table>
          </div>
      </div>
  </div>
</main>

<script type="module">
    import * as THREE from 'https://unpkg.com/three@0.160.0/build/three.module.js';
    import { OrbitControls } from 'https://unpkg.com/three@0.160.0/examples/jsm/controls/OrbitControls.js';
    import { GLTFLoader } from 'https://unpkg.com/three@0.160.0/examples/jsm/loaders/GLTFLoader.js';
    import { DRACOLoader } from 'https://unpkg.com/three@0.160.0/examples/jsm/loaders/DRACOLoader.js';
    import { OBJLoader } from 'https://unpkg.com/three@0.160.0/examples/jsm/loaders/OBJLoader.js';
    import { FBXLoader } from 'https://unpkg.com/three@0.160.0/examples/jsm/loaders/FBXLoader.js';

    // Jadikan variabel global agar fungsi onclick HTML bisa mengaksesnya
    window.THREE = THREE;
    
    function updateFileName(input) {
        if (input.files && input.files[0]) {
            document.getElementById('fileNameDisplay').textContent = input.files[0].name;
            document.getElementById('uploadBtn').style.display = 'inline-flex';
        } else {
            document.getElementById('fileNameDisplay').textContent = '';
            document.getElementById('uploadBtn').style.display = 'none';
        }
    }

    // --- Three.js Setup ---
    let scene, camera, renderer, controls;
    let currentModel = null;
    let autoRotate = true;
    let isWireframe = false;
    let animationId;
    let mixer; // For animations if gltf has them
    const clock = new THREE.Clock();

    function init3DViewer() {
        const container = document.getElementById('canvas-container');
        if (!container) return;
        
        // Scene
        scene = new THREE.Scene();
        scene.background = new THREE.Color(0x070b10); // Match dark theme bg
        // Optional: Add fog for depth
        scene.fog = new THREE.FogExp2(0x070b10, 0.02);
        
        // Grid Helper for context
        const gridHelper = new THREE.GridHelper(20, 20, 0x00ff88, 0x222222);
        gridHelper.material.opacity = 0.2;
        gridHelper.material.transparent = true;
        scene.add(gridHelper);
        
        // Camera
        camera = new THREE.PerspectiveCamera(45, container.clientWidth / container.clientHeight, 0.1, 100);
        camera.position.set(5, 3, 5);
        
        // Renderer
        renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
        renderer.setSize(container.clientWidth, container.clientHeight);
        renderer.setPixelRatio(window.devicePixelRatio);
        // renderer.outputEncoding = THREE.sRGBEncoding; // r128 way
        // renderer.toneMapping = THREE.ACESFilmicToneMapping;
        renderer.toneMappingExposure = 1.0;
        container.appendChild(renderer.domElement);
        
        // Controls
        controls = new OrbitControls(camera, renderer.domElement);
        controls.enableDamping = true;
        controls.dampingFactor = 0.05;
        controls.autoRotate = autoRotate;
        controls.autoRotateSpeed = 2.0;
        
        // Lights
        const ambientLight = new THREE.AmbientLight(0xffffff, 0.6);
        scene.add(ambientLight);
        
        const dirLight = new THREE.DirectionalLight(0xffffff, 0.8);
        dirLight.position.set(5, 10, 7.5);
        scene.add(dirLight);
        
        const dirLight2 = new THREE.DirectionalLight(0x00e5ff, 0.5); // Cyan tint
        dirLight2.position.set(-5, 5, -5);
        scene.add(dirLight2);
        
        // Handle window resize
        window.addEventListener('resize', onWindowResize, false);
        
        // Load initial model if available
        const firstModelEl = document.querySelector('.model-item.selected');
        if (firstModelEl) {
            loadModel(firstModelEl.dataset.path, firstModelEl);
        } else {
            // Add a default geometry if no models uploaded
            const geometry = new THREE.TorusKnotGeometry(1, 0.3, 100, 16);
            const material = new THREE.MeshStandardMaterial({ 
                color: 0x00ff88, 
                metalness: 0.7, 
                roughness: 0.2,
                wireframe: isWireframe
            });
            currentModel = new THREE.Mesh(geometry, material);
            scene.add(currentModel);
            animate();
        }
    }
    
    function onWindowResize() {
        const container = document.getElementById('canvas-container');
        if (!container || !camera || !renderer) return;
        
        camera.aspect = container.clientWidth / container.clientHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(container.clientWidth, container.clientHeight);
    }
    
    function animate() {
        animationId = requestAnimationFrame(animate);
        
        const delta = clock.getDelta();
        if (mixer) mixer.update(delta);
        
        if (controls) controls.update();
        if (renderer && scene && camera) {
            renderer.render(scene, camera);
        }
    }
    
    // UI Controls
    function toggleAutoRotate() {
        autoRotate = !autoRotate;
        if (controls) controls.autoRotate = autoRotate;
        const btn = document.getElementById('btn-rotate');
        if (autoRotate) btn.classList.add('active');
        else btn.classList.remove('active');
    }
    
    function toggleWireframe() {
        isWireframe = !isWireframe;
        const btn = document.getElementById('btn-wireframe');
        if (isWireframe) btn.classList.add('active');
        else btn.classList.remove('active');
        
        if (currentModel) {
            currentModel.traverse((child) => {
                if (child.isMesh && child.material) {
                    // Handle array of materials or single material
                    if (Array.isArray(child.material)) {
                        child.material.forEach(mat => mat.wireframe = isWireframe);
                    } else {
                        child.material.wireframe = isWireframe;
                    }
                }
            });
        }
    }
    
    function resetCamera() {
        if (camera && controls) {
            // Determine box to frame it
            if (currentModel) {
                const box = new THREE.Box3().setFromObject(currentModel);
                const size = box.getSize(new THREE.Vector3()).length();
                const center = box.getCenter(new THREE.Vector3());
                
                controls.target.copy(center);
                camera.position.set(center.x + size, center.y + size * 0.5, center.z + size);
                camera.lookAt(center);
            } else {
                camera.position.set(5, 3, 5);
                controls.target.set(0, 0, 0);
            }
            controls.update();
        }
    }
    
    function loadModel(path, element, name = null) {
        if (!path) return;
        
        // Update UI selection
        if (element) {
            document.querySelectorAll('.model-item').forEach(el => el.classList.remove('selected'));
            element.classList.add('selected');
        } else if (name) {
            // Try to find in list
            document.querySelectorAll('.model-item').forEach(el => {
                if (el.textContent.includes(name)) {
                    document.querySelectorAll('.model-item').forEach(e => e.classList.remove('selected'));
                    el.classList.add('selected');
                }
            });
        }
        
        const overlay = document.getElementById('loading-overlay');
        const progressBar = document.getElementById('loading-bar');
        const progressText = document.getElementById('loading-percentage');
        
        overlay.style.display = 'flex';
        overlay.style.opacity = '1';
        progressBar.style.width = '0%';
        progressText.innerText = '0%';
        
        // Remove old model
        if (currentModel) {
            scene.remove(currentModel);
            // Free resources
            currentModel.traverse((child) => {
                if (child.isMesh) {
                    if (child.geometry) child.geometry.dispose();
                    if (child.material) {
                        if (Array.isArray(child.material)) {
                            child.material.forEach(mat => mat.dispose());
                        } else {
                            child.material.dispose();
                        }
                    }
                }
            });
            currentModel = null;
            mixer = null;
        }
        
        const ext = path.split('.').pop().toLowerCase();
        
        const onProgress = (xhr) => {
            if (xhr.lengthComputable && xhr.total > 0) {
                const percentComplete = (xhr.loaded / xhr.total) * 100;
                progressBar.style.width = percentComplete + '%';
                progressText.innerText = Math.round(percentComplete) + '%';
            } else {
                // Tampilkan besaran file yg terdownload
                const loadedMB = (xhr.loaded / (1024 * 1024)).toFixed(2);
                progressBar.style.width = '100%';
                progressBar.style.animation = 'pulse 2s infinite';
                progressText.innerText = `Memuat ${loadedMB} MB ...`;
            }
        };
        
        const onError = (error) => {
            console.error('Error loading model:', error);
            // Tambahkan logger yang muncul di layar (dalam progress text)
            progressText.innerText = 'Error! (Lihat Console F12)';
            progressBar.style.backgroundColor = 'red';
            
            setTimeout(() => {
                overlay.style.display = 'none';
            }, 8000);
            
            // Tampilkan alert error khusus
            alert('Gagal memuat model 3D.\n\nDetail:\n' + (error.message || 'Error CORS/Network atau format tidak valid.\n\nTips:\nPastikan model Anda diekspor dengan opsi yang benar (Hindari kompresi webp/draco tingkat tinggi jika tidak perlu).'));
        };
        
        const onLoadFinish = (object) => {
            currentModel = object;
            
            // Apply current wireframe setting
            if (isWireframe) {
                currentModel.traverse((child) => {
                    if (child.isMesh && child.material) {
                        if (Array.isArray(child.material)) {
                            child.material.forEach(mat => mat.wireframe = true);
                        } else {
                            child.material.wireframe = true;
                        }
                    }
                });
            }
            
            // Center and scale object
            const box = new THREE.Box3().setFromObject(object);
            const size = box.getSize(new THREE.Vector3()).length();
            const center = box.getCenter(new THREE.Vector3());
            
            object.position.x += (object.position.x - center.x);
            object.position.y += (object.position.y - center.y);
            object.position.z += (object.position.z - center.z);
            
            // Scale if too big or too small (target size ~5)
            const targetSize = 5;
            if (size > 0 && size !== targetSize) {
                const scale = targetSize / size;
                object.scale.set(scale, scale, scale);
            }
            
            scene.add(object);
            resetCamera();
            
            setTimeout(() => {
                overlay.style.opacity = '0';
                setTimeout(() => { overlay.style.display = 'none'; }, 300);
            }, 500);
            
            if (!animationId) animate();
        };

        if (ext === 'gltf' || ext === 'glb') {
            const loader = new GLTFLoader();
            // Setup DRACOLoader for compressed models
            try {
                const dracoLoader = new DRACOLoader();
                // Gunakan decoder google yang paling universal untuk module
                dracoLoader.setDecoderPath('https://www.gstatic.com/draco/v1/decoders/');
                dracoLoader.setDecoderConfig({ type: 'js' });
                loader.setDRACOLoader(dracoLoader);
            } catch (e) {
                console.warn('DRACOLoader setup failed:', e);
            }
            
            // Tambahkan basePath untuk Vercel / Express
            const absolutePath = path.startsWith('/') ? window.location.origin + path : path;
            
            console.log("Loading GLTF/GLB from:", absolutePath);
            loader.load(absolutePath, (gltf) => {
                const object = gltf.scene;
                
                // Play animations if exist
                if (gltf.animations && gltf.animations.length > 0) {
                    mixer = new THREE.AnimationMixer(object);
                    gltf.animations.forEach((clip) => {
                        mixer.clipAction(clip).play();
                    });
                }
                
                onLoadFinish(object);
            }, onProgress, onError);
        } else if (ext === 'obj') {
            const loader = new OBJLoader();
            loader.load(path, onLoadFinish, onProgress, onError);
        } else if (ext === 'fbx') {
            // Ensure FBXLoader script is loaded for this to work
            const loader = new FBXLoader();
            loader.load(path, (object) => {
                if (object.animations && object.animations.length > 0) {
                    mixer = new THREE.AnimationMixer(object);
                    object.animations.forEach((clip) => {
                        mixer.clipAction(clip).play();
                    });
                }
                onLoadFinish(object);
            }, onProgress, onError);
        } else {
            onError(new Error("Format not supported via generic loader setup"));
        }
    }

    // Ekspos loadModel ke window agar onclick="loadModel(...)" di HTML tetap jalan
    window.loadModel = loadModel;
    window.toggleAutoRotate = toggleAutoRotate;
    window.toggleWireframe = toggleWireframe;
    window.resetCamera = resetCamera;
    window.updateFileName = updateFileName;
    
    // Initialize when DOM is ready
    document.addEventListener('DOMContentLoaded', () => {
        init3DViewer();
    });

</script>
</body>
</html>